# Real personal data — never commit (DPDP). The xlsx and everything derived
# from it contain names, phone numbers and workplace GPS of real employees.
input/*.xlsx
master-data/

# Deployment secrets / instance config
app/js/config.js
console/js/config.js
.clasp.json

# Local clutter
node_modules/
*.log

# Local debug screenshots (may contain personal browser info)
Error Snap/

# Unrelated project files kept locally
/RUNBOOK.md

# Play Store packaging output — contains the signing keystore + passwords. NEVER commit.
/Play/

# Tester onboarding sheets — personal contact data, never public.
/request/

# clasp deploy plumbing: script id lives in .clasp.json (never commit ids);
# Code.gs is a generated copy of COMBINED.gs
backend/clasp/.clasp.json
backend/clasp/Code.gs
backend/clasp/appsscript.json

# Commercial documents — keep out of the public repo
Deployment/BOQ.xlsx
Deployment/BOQ.docx
Deployment/BOQ.pdf

# E2E evidence runs (screenshots of test data)
artifacts/
Training/img/
